return(function(...)local A=string.char;local B=table.concat;local C=loadstring or load;local function X(a,b)local r,p=0,1 a,b=math.floor(a),math.floor(b) while a>0 or b>0 do local ab,bb=a%2,b%2 if ab~=bb then r=r+p end a=(a-ab)/2 b=(b-bb)/2 p=p*2 end return r end;local function D(s)local t={}local k=199 for i=1,#s do t[i]=A(X(s:byte(i),(k+(i-1)*13)%256)) end return B(t) end;local function E(s)local b="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" local T={} for i=1,#b do T[b:sub(i,i)]=i-1 end s=s:gsub("[^%w%+%/%=]","") local o={} local n=1 for i=1,#s,4 do local a1=T[s:sub(i,i)]or 0 local a2=T[s:sub(i+1,i+1)]or 0 local a3=T[s:sub(i+2,i+2)]or 0 local a4=T[s:sub(i+3,i+3)]or 0 local n1=a1*4+math.floor(a2/16) local n2=(a2%16)*16+math.floor(a3/4) local n3=(a3%4)*64+a4 o[n]=A(n1%256) n=n+1 if s:sub(i+2,i+2)~="="then o[n]=A(n2%256) n=n+1 end if s:sub(i+3,i+3)~="="then o[n]=A(n3%256) n=n+1 end end return B(o) end;local F={"6vm6tfEoNQIPXyY6B14K/vGukZ7r+JaTmWk5VVosKDQTVEM5u8fHoKaoyZhmcW9PRDBxnNxY7Pzr3tbmp5KMk2txUyRmFV9oBhqp+MzEna22iZTEQmtpXV4oPAJbqa3uz9Gv7quLlG5jNE9DLTMpAxjqubeL36S/usK1aXJESF59AwAHD6C8","gsrSrf/DlZNuHS5dUSg5CVIv4Pjf1rK++trUZm92TQ8FKig6E/Hm9MnS7POOh5l8d21fG29ZDAIZ5viB/M6mhoedimB1RhAAajAFHBux38DG7KmrkJpjaDIFZjQgCA0H9Ob/zJTq2rGFlGV9Pn5xFnJiTB7n/sWX/aKgsouJfnxBShRrAxAV","D8P51MTKmL2XhJZvfAQaSiE1BBXtrtjHx6eIqYDWPjB6S1ohaxkODNb37drQpbbIz7loZkRpTiF3S2UQ5vXC3J2ZuJGfmlh9V0RWLzxGTqDq+8rR+4m+nKZnfWpAVSZ4fzkY8f/6+N23pLaPnCQ6KkFVJDUNTi//8MfB76yklZmebzcZEVkq","NQBIOOnt9dayu7OEkSksT19QJyEPDAT1+f7Ple3bsoSbZH4/f00nIRQICMDhyI6G6LKDgpkzUUZEbi8lEhgd7rCH4cutq5KWckpvThZoRDcHFuPjvOXfpLipg5ljMSMLXyQ/OlY+4+fzyMixvYKL0ypZS0hUPT8NF1+jna7d0ai5idKzXDkb","ExAhOx4R8/215NqhrrC5mmJpeFg9Mzk3Bx2l/PDYmYqDwImVJ2BAXVBmIgMGCKG/g/zt6urEoZJqYUBATGIVCRDh4crL1birqciQbGsWRVkgMTFKNOX8vpaYsr2th4p2ckNIFAQhExwe5uHhztGspIL692Z4R1BSaz4QHBz48Mnd4Kq/k6tp","e3IAHEhvfElW7//+y9vktv7W2HdzaEtcMnsHCA7h8c/Yk+H5ws2bbGJLRVRofkQeDKuwwtfLq7yIhSBsdEMUMy8sDxD2p/vMwqS1s5zfLT0+CV8gJjcZEKS6iaea5/TBh50oYVtf